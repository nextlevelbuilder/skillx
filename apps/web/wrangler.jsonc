{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillx-web",
  "compatibility_date": "2026-02-05",
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Custom domains configured via Cloudflare dashboard (skillx.sh, www.skillx.sh)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skillx-db",
      "database_id": "cc79aa75-f43d-47c3-b1f8-b0317a547144",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "skillx-skills"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3d4594dc42124efdad7aba2da677ffac"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "skillx-assets"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Per-caller limit of the release read API (user ID or client IP), counted per Cloudflare location.
  // Keep limit/period in sync with RELEASE_READ_RATE_LIMIT / _WINDOW_SECONDS in release-rate-limit.ts.
  // namespace_id is a positive integer unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "RELEASE_READ_LIMITER",
      "namespace_id": "5401",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    // Per-caller limit of the release state write routes; every write appends an audit row.
    // Keep limit/period in sync with RELEASE_WRITE_RATE_LIMIT / _WINDOW_SECONDS in release-rate-limit.ts.
    {
      "name": "RELEASE_WRITE_LIMITER",
      "namespace_id": "5402",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Release publish API (POST /api/v1/packages/@handle/slug/releases). "0" = off (404).
    // Turning it on also needs the secrets SKILLX_REGISTRY_SIGNING_KEY and SKILLX_REGISTRY_SIGNING_KEY_ID.
    "SKILLX_RELEASES_API": "1",
    // Subrequests (D1 + R2 calls) one release publish may spend; above it the upload is refused with 413
    // before any R2 write. Workers Paid allows 10,000 per request; on a free account (1,000) set ~600.
    "SKILLX_RELEASE_SUBREQUEST_BUDGET": "5000",
    // Personal kit API (/api/v1/kits/@handle/name/...). "0" = off (404 everywhere); rollback = set "0" and redeploy.
    "SKILLX_PERSONAL_KITS_API": "1",
    // Collections API (/api/v1/collections/...). "0" = off (404 everywhere); rollback = set "0" and redeploy. Needs migration 0019.
    "SKILLX_COLLECTIONS_API": "1"
  }
}
